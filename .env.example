# Copy to .env and fill in. .env is never committed or copied into the image.
LLM_BASE_URL=https://103.42.50.41:1031/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_CA_CERT=certs/vm07-ca.crt

# Rate limits and cache (defaults shown)
RATE_PER_MIN=6
RATE_BURST=3
GLOBAL_PER_MIN=30
CACHE_TTL_S=3600
CACHE_MAX_ITEMS=256
MAX_QUERY_CHARS=1000
GATE_WAIT_S=90

# Web server (rto-serve). Leave RTO_HOST unset in Docker (the image sets 0.0.0.0).
# RTO_HOST=127.0.0.1
# RTO_PORT=8000

# Which eval set the CLIs use (v1 frozen, v2 extended)
RTO_EVAL_SET=v2

# Optional: send traces to Langfuse or any OTLP/HTTP backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>

# Second model (optional): bash setup_ollama.sh, keep the Ollama app open
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1-16k

# Hugging Face router (optional, small free credit)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
